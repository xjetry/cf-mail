# 环境变量配置示例：cp .env.example .env 后修改
# 管理 API / Web UI 的 Bearer Token（务必改成强随机值，如: openssl rand -hex 24）
ADMIN_TOKEN=dev-token

# 你的邮件域名（收件地址后缀固定为此域名）
MAIL_DOMAIN=example.com

# 可选：Worker 自定义管理域名（不设置则使用默认 workers.dev）
CUSTOM_DOMAIN=mail.example.com

# CLI 连接配置（本地 cfm / 远程 cfmctl）
CFM_URL=http://localhost:8787
CFM_TOKEN=dev-token
CFMCTL_URL=https://mail.example.com
CFMCTL_TOKEN=dev-token
